# The OpenBeach icon (assets/logo/openbeach.ico, tools/make_icons.py) as a byte array in openbeach_icon.gen.h: the window
# icon on every system (src/platform/sdl_present.cpp). Generated at configure time; a new icon regenerates it.
function(obl_embedded_icon target)
    set(icon "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../assets/logo/openbeach.ico")
    set(header "${CMAKE_CURRENT_BINARY_DIR}/openbeach_icon.gen.h")
    file(SIZE "${icon}" size)
    if(NOT EXISTS "${header}" OR "${icon}" IS_NEWER_THAN "${header}")
        file(READ "${icon}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        file(WRITE "${header}" "// Generated by cmake/embedded_icon.cmake from assets/logo/openbeach.ico; do not edit.\n#pragma once\n\n"
            "inline constexpr unsigned char kOpenBeachIcon[${size}] = {\n${bytes}};\n")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${icon}")
    target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
endfunction()
