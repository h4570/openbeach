// The version resource of a Windows executable: Explorer shows it under Properties > Details, and a crash report or an
// installer can read which build it is. Configured by cmake/version_resource.cmake from version.txt.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "OpenBeach"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "FileDescription", "@OBL_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@OBL_RC_NAME@"
            VALUE "OriginalFilename", "@OBL_RC_NAME@.exe"
            VALUE "LegalCopyright", "GNU General Public License v3, https://github.com/h4570/openbeach"
            VALUE "Comments", "Open-source engine for Beach Life; an unofficial fan project"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
