function(obl_catalog_schemas target)
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    set(OBL_CATALOG_SCHEMAS "")
    foreach(name common catalog_index commodity_family commodity opening_hours desire desire_slot staff event beer fine vehicle table scenery building guest_set map scenario campaign text gui_layouts)
        set(path "${root}/data/schemas/${name}.schema.json")
        file(READ "${path}" content)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        string(APPEND OBL_CATALOG_SCHEMAS "R\"obl_schema(${content})obl_schema\",\n")
    endforeach()
    configure_file("${root}/cmake/catalog_schemas.h.in" "${CMAKE_CURRENT_BINARY_DIR}/catalog_schemas.h" @ONLY)
    target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
endfunction()
