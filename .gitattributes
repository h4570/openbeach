*.sh text eol=lf
# The executable of the macOS app bundle, a bash script without an extension.
tools/ci/release/macos/openbeach-launcher text eol=lf
# Pack data is read byte for byte (the GUI layout header ends in a bare LF, file hashes): no CRLF conversion on checkout.
data/packs/** -text
# The replay header hashes these mod files byte for byte.
tests/mods/l0_rule/** text eol=lf
tests/mods/l0_world_script/** text eol=lf
tests/mods/l0_busker/** text eol=lf
# The script readers compare the header line byte for byte: a CRLF checkout on Windows would refuse every test mod script.
tests/mods/**/*.wsc text eol=lf
tests/mods/**/*.obs text eol=lf
# Ship official manifests and scripts with the same line endings on every platform.
data/mods/**/mod.json text eol=lf
data/mods/**/*.lua text eol=lf
# Binary references: a line-ending rewrite must never touch them.
*.png binary
# cmd.exe misreads labels and blocks of a batch file with bare LF endings.
*.cmd text eol=crlf
*.ico binary
