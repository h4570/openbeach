{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obl.desire",
  "title": "Desire (catalog/desires/<key>.json)",
  "description": "A guest desire and the commodity families that satisfy it (game-data.md, 'Catalog').",
  "type": "object",
  "properties": {
    "format": {
      "const": "obl.desire"
    },
    "version": {
      "const": 2
    },
    "key": {
      "$ref": "obl.common#/$defs/key"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name or text-table key."
    },
    "families": {
      "$ref": "obl.common#/$defs/key_list"
    }
  },
  "required": [
    "format",
    "version",
    "key",
    "name",
    "families"
  ],
  "additionalProperties": false
}
