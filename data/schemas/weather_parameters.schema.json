{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obl.weather_parameters",
  "title": "Weather lighting parameters",
  "type": "object",
  "properties": {
    "format": {
      "const": "obl.weather_parameters"
    },
    "version": {
      "const": 2
    },
    "light_keys": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 23
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          }
        ],
        "items": false
      }
    },
    "state_colors": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 16777215
      }
    }
  },
  "required": [
    "format",
    "version",
    "light_keys",
    "state_colors"
  ],
  "additionalProperties": false
}
