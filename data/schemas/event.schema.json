{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obl.event",
  "title": "Event (catalog/events/<key>.json)",
  "description": "A show a building can hold (game-data.md, 'Catalog').",
  "type": "object",
  "properties": {
    "format": {
      "const": "obl.event"
    },
    "version": {
      "const": 2
    },
    "key": {
      "$ref": "obl.common#/$defs/key"
    },
    "cost": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "intensity": {
      "description": "[men, women].",
      "$ref": "obl.common#/$defs/vec2"
    }
  },
  "required": [
    "format",
    "version",
    "key",
    "cost",
    "price",
    "intensity"
  ],
  "additionalProperties": false
}
