{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obl.object_script_vocabulary",
  "type": "object",
  "properties": {
    "format": {
      "const": "obl.object_script_vocabulary"
    },
    "version": {
      "const": 1
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 100
    }
  },
  "required": [
    "format",
    "version",
    "states",
    "messages"
  ],
  "additionalProperties": false
}
