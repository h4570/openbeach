      "$ref": "obl.common#/$defs/key_list",
      "uniqueItems": true
    },
    "desire_slots": {
      "$ref": "obl.common#/$defs/key_list",
      "uniqueItems": true
    },
    "staff": {
      "$ref": "obl.common#/$defs/key_list",
      "uniqueItems": true
    },
    "events": {
      "$ref": "obl.common#/$defs/key_list",
      "uniqueItems": true
    },
    "beers": {
      "$ref": "obl.common#/$defs/key_list",
      "uniqueItems": true
    },
    "fines": {
      "$ref": "obl.common#/$defs/key_list",
      "uniqueItems": true
