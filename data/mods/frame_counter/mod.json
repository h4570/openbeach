{
  "format": "obl.mod",
  "version": 1,
  "id": "frame_counter",
  "title": "Frame Counter",
  "description": "Shows the frames per second and the latest frame time in a corner of the screen. You choose the corner.",
  "mod_version": "1.0.1",
  "packs": ["base", "l0"],
  "scope": "presentation",
  "api": 1,
  "settings": [
    { "id": "enabled", "type": "toggle", "label": "Show frame counter", "default": true },
    {
      "id": "corner",
      "type": "choice",
      "label": "Screen corner",
      "default": "top_left",
      "options": [
        { "value": "top_left", "label": "Top left" },
        { "value": "top_right", "label": "Top right" },
        { "value": "bottom_left", "label": "Bottom left" },
        { "value": "bottom_right", "label": "Bottom right" }
      ]
    }
  ]
}
