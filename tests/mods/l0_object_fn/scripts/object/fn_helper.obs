#obl-script 1 object
// Test script of an object a mod script created: it charges 2 and removes itself.

State STATE_NULL
	OnUpdate
	End
	OnEntry
		Set WalkAnimation "D_WALK_NORMAL";
		Set StandAnimation "D_STAND_NORMAL";
		Set WalkSpeed 60;
		ChangeState STATE_STARTUP;
	End
End

State STATE_STARTUP
	OnUpdate
	End
	OnEntry
		ChangeState STATE_FN_RUN;
	End
	OnExit
		PlayAnimation WalkAnimation;
	End
End

State STATE_FN_RUN
	OnEntry
		PlayAnimation StandAnimation;
		Set Arg1 2;
		Function ChargeMoney;
		Set Arg1 Me;
		Function RemoveObject;
	End
End
